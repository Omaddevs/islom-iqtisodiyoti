# --- Server ---
PORT=4020
# Frontend manzili (CORS / WebSocket origin tekshiruvi). Bir nechta bo'lsa vergul bilan.
APP_ORIGIN=http://localhost:2026

# --- PostgreSQL ---
# docker compose up -d db  → quyidagi satr bilan ishlaydi
DATABASE_URL=postgres://ii_app:ii_dev_password@localhost:5436/islom_iqtisodiyoti

# --- Xavfsizlik ---
# HTTPS'gacha (faqat IP orqali) vaqtincha: COOKIE_SECURE=false. Domen + SSL ulangach olib tashlang.
# COOKIE_SECURE=false
# Kamida 32 belgili tasodifiy satr: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Telegram bot (ixtiyoriy) ---
# @BotFather tokeni. Bitta token bilan faqat BITTA server ishlashi kerak (lokalda bo'sh qoldiring)
BOT_TOKEN=
# Doimiy bot adminlari (Telegram ID, vergul bilan)
BOT_ADMIN_IDS=8083504130
# Mini App manzili (https)
BOT_APP_URL=https://islom-iqtisodiyoti.uz/#/kirish

# --- WebRTC ---
# STUN/TURN serverlar (JSON). Productionda o'z TURN serveringizni (coturn) qo'shing,
# aks holda qattiq NAT ortidagi foydalanuvchilar ulana olmaydi.
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]

# --- Bosh administrator (npm run db:seed) ---
# Faqat birinchi marta yaratiladi. Kirgandan so'ng parolni Sozlamalar → Parolni o'zgartirish orqali almashtiring.
SUPERADMIN_NAME=Anvar Tursunov
SUPERADMIN_PHONE=+998 90 739 21 11
SUPERADMIN_PASSWORD=change-me-strong-password

# --- Fayllar ---
STORAGE_DIR=./storage
